# ---- Server ----
PORT=3000
HOST=localhost
APP_ENV=local

# ---- Payments (Razorpay) ----
# The prototype simulates checkout in the browser. These values are shown in
# Admin > Settings and are ready for when a real backend is wired up.
PAYMENT_MODE=simulated
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Server-only secret. Never exposed to the browser by server.js.
RAZORPAY_KEY_SECRET=replace_with_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# ---- App ----
GST_RATE=0.18
SUPPORT_EMAIL=support@mytrm.in
